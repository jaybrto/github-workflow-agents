# GWA Android Dashboard — Local Configuration
# Copy this file to local.properties and fill in your values.
# local.properties is git-ignored and should never be committed.

# Orchestrator REST API
GWA_API_URL=http://10.43.x.x:3001
GWA_API_KEY=your-api-key

# RabbitMQ MQTT
GWA_MQTT_HOST=10.43.x.x
GWA_MQTT_PORT=1883
GWA_MQTT_WSS_URL=wss://mqtt.bto.bar/ws

# Push notifications
GWA_NTFY_URL=https://ntfy.bto.bar/gwa

# MinIO (recordings)
GWA_MINIO_ENDPOINT=minio.bto.bar:9000
