FROM oven/bun:1-debian AS builder
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY tsconfig.json ./
COPY src/ src/
COPY schema.sql .
RUN bun build src/orchestrator/index.ts --compile --outfile /usr/local/bin/gwa-orchestrator

FROM gcr.io/distroless/base-debian12
WORKDIR /app
COPY --from=builder /usr/local/bin/gwa-orchestrator /app/gwa-orchestrator
EXPOSE 3001
ENTRYPOINT ["/app/gwa-orchestrator"]
