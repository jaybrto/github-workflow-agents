# GitHub App Credentials for WorkflowAgents-BTO
# Copy this file to .env and fill in your values

# GitHub App Configuration
GITHUB_APP_NAME=Workflow-Agents-BTO
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SECRET=
GITHUB_APP_WEBHOOK=https://git-hooks.bto.bar

# Private key path (download from GitHub App settings)
GITHUB_APP_PRIVATE_KEY_PATH=./workflow-agents-bto.pem

# Installation ID (set after installing the app on org)
GITHUB_APP_INSTALLATION_ID=

# Kubernetes Configuration
GWA_POD=gwa-runner-0
GWA_NAMESPACE=default